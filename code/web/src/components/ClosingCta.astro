---
---

<div class="border-b border-rule">
  <div class="section-wide py-32 text-center">
    <svg
      class="logo-animated mx-auto mb-8 h-17 w-auto"
      viewBox="-86 -4 236 68"
      role="img"
      aria-label="bufferq"
    >
      <style>
        .s{animation:gls 8s 1 cubic-bezier(.6,0,.2,1) forwards;animation-play-state:paused}
        .b{animation:glb 8s 1 cubic-bezier(.65,0,.25,1) forwards;animation-play-state:paused}
        .q{animation:glq 8s 1 cubic-bezier(.65,0,.25,1) forwards;animation-play-state:paused}
        .d{transform-box:fill-box;transform-origin:center;animation:gld 8s 1 ease-in-out forwards;animation-play-state:paused}
        .l1{animation:gl1 8s 1 ease-out forwards;animation-play-state:paused}
        .l2{animation:gl2 8s 1 ease-out forwards;animation-play-state:paused}
        .l3{animation:gl3 8s 1 ease-out forwards;animation-play-state:paused}
        .logo-animated.is-playing .s,
        .logo-animated.is-playing .b,
        .logo-animated.is-playing .q,
        .logo-animated.is-playing .d,
        .logo-animated.is-playing .l1,
        .logo-animated.is-playing .l2,
        .logo-animated.is-playing .l3{animation-play-state:running}
        @keyframes gls{0%,38%{transform:rotate(0deg)}62%,100%{transform:rotate(360deg)}}
        @keyframes glb{0%,16%{transform:translateX(-87.3px)}34%,64%{transform:translateX(0)}82%,100%{transform:translateX(-87.3px)}}
        @keyframes glq{0%,16%{transform:translateX(87.3px)}34%,64%{transform:translateX(0)}82%,100%{transform:translateX(87.3px)}}
        @keyframes gld{0%,82%{transform:scale(1)}86%{transform:scale(1.6)}94%,100%{transform:scale(1)}}
        @keyframes gl1{0%,16%{opacity:1;transform:none}22%,76%{opacity:0;transform:translateY(10px)}82%,100%{opacity:1;transform:none}}
        @keyframes gl2{0%,13%{opacity:1;transform:none}19%,79%{opacity:0;transform:translateY(10px)}85%,100%{opacity:1;transform:none}}
        @keyframes gl3{0%,10%{opacity:1;transform:none}16%,82%{opacity:0;transform:translateY(10px)}88%,100%{opacity:1;transform:none}}
        @media (prefers-reduced-motion:reduce){.s{animation:none}.b{animation:none;transform:translateX(-87.3px)}.q{animation:none;transform:translateX(87.3px)}.d{animation:none}.l1,.l2,.l3{animation:none;opacity:1}}
      </style>
      <g transform="translate(32 32)"><g class="s">
        <g class="b"><circle cx="0" cy="0" r="11" fill="none" stroke="#111111" stroke-width="6" /><rect x="-14" y="-24" width="6" height="38" rx="3" fill="#111111" /></g>
        <g class="q"><circle cx="0" cy="0" r="11" fill="none" stroke="#111111" stroke-width="6" /><rect x="8" y="-14" width="6" height="38" rx="3" fill="#111111" /><circle class="d" cx="0" cy="0" r="4" fill="#22a06b" /></g>
      </g></g>
      <g font-family="'JetBrains Mono', ui-monospace, Menlo, monospace" font-weight="700" font-size="52" text-anchor="middle" fill="#111111">
        <text class="l3" x="-25.65" y="46">u</text>
        <text class="l2" x="3.45" y="46">f</text>
        <text class="l1" x="32.55" y="46">f</text>
        <text class="l2" x="61.65" y="46">e</text>
        <text class="l3" x="90.75" y="46">r</text>
      </g>
    </svg>
    <h2 class="h2-cta mx-auto max-w-180">Put a bouncer on your API.</h2>
    <p class="mx-auto mt-5 max-w-130 text-[17px] leading-relaxed text-muted">
      A sidecar next to your API. No proxy, no DNS changes.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-dark" href="https://github.com/czioutas/bufferq">Get started</a>
      <a class="btn btn-line" href="#flow">Watch it decide</a>
    </div>
  </div>
</div>

<script>
  const logo = document.querySelector<SVGElement>(".logo-animated");
  if (logo) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            logo.classList.add("is-playing");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(logo);
  }
</script>
