33%{opacity:0;color:var(--color-status-grant);transform:translateX(765px) scale(2.2)}
100%{opacity:0;color:var(--color-ink-2);transform:translateX(0) scale(.4)}}

@keyframes pb{
0%{opacity:0;color:var(--color-ink-2);transform:translateX(0) scale(.4)}
8%{opacity:1;color:var(--color-ink-2);transform:translateX(0) scale(1)}
19.5%{opacity:1;color:var(--color-ink-2);transform:translateX(350px) scale(1)}
21%{opacity:1;color:var(--color-status-queue);transform:translateX(334px) scale(1)}
28%{opacity:1;color:var(--color-status-queue);transform:translateX(170px) scale(1)}
34%{opacity:1;color:var(--color-status-queue);transform:translateX(170px) scale(1.18)}
40%{opacity:1;color:var(--color-status-queue);transform:translateX(170px) scale(1)}
46%{opacity:1;color:var(--color-status-queue);transform:translateX(170px) scale(1.18)}
50%{opacity:1;color:var(--color-status-queue);transform:translateX(170px) scale(1)}
52%{opacity:1;color:var(--color-status-retry);transform:translateX(170px) scale(1)}
