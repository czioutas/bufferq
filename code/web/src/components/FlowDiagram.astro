<style>
.t{animation-duration:calc(18s*var(--k,1));animation-iteration-count:1;animation-fill-mode:both;animation-timing-function:cubic-bezier(.4,.05,.25,1);animation-play-state:paused}
.mint{color:var(--color-status-grant)}.amber{color:var(--color-status-queue)}.coral{color:var(--color-status-reject)}.violet{color:var(--color-status-retry)}.blue{color:var(--color-ink-2)}.pink{color:var(--color-status-bill)}

/* one-shot pulses, placed in the loop by their delay */
.win{animation-name:win;opacity:0}
.ring{animation-name:ring;opacity:0;position:absolute;width:40px;height:40px;border-radius:50%;border:2px solid currentColor;box-sizing:border-box;pointer-events:none}
.chip{position:absolute;height:26px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:4px;font:500 12px/1 var(--font-mono);letter-spacing:.04em;white-space:nowrap;background:color-mix(in srgb,currentColor 9%,var(--color-paper-2));border:1px solid color-mix(in srgb,currentColor 50%,transparent);box-shadow:0 2px 6px color-mix(in srgb,var(--color-ink) 08%,transparent)}

/* start times, as a share of the 18s loop */
.s3{animation-delay:calc(.54s*var(--k,1))}
.s8{animation-delay:calc(1.44s*var(--k,1))}
.s13{animation-delay:calc(2.34s*var(--k,1))}
.s14{animation-delay:calc(2.52s*var(--k,1))}
.s195{animation-delay:calc(3.51s*var(--k,1))}
.s245{animation-delay:calc(4.41s*var(--k,1))}
.s315{animation-delay:calc(5.67s*var(--k,1))}
.s46{animation-delay:calc(8.28s*var(--k,1))}
.s52{animation-delay:calc(9.36s*var(--k,1))}
.s54{animation-delay:calc(9.72s*var(--k,1))}
.s60{animation-delay:calc(10.8s*var(--k,1))}
.s70{animation-delay:calc(12.6s*var(--k,1))}
.s755{animation-delay:calc(13.59s*var(--k,1))}
.s78{animation-delay:calc(14.04s*var(--k,1))}
.s915{animation-delay:calc(16.47s*var(--k,1))}
.s18{animation-delay:calc(3.24s*var(--k,1))}
.s29{animation-delay:calc(5.22s*var(--k,1))}
.s50{animation-delay:calc(9s*var(--k,1))}
.s55{animation-delay:calc(9.9s*var(--k,1))}
.s64{animation-delay:calc(11.52s*var(--k,1))}

.pk{position:absolute;width:18px;height:18px;border-radius:50%;background:currentColor;box-shadow:0 0 0 3px var(--color-paper-2),0 4px 12px color-mix(in srgb,var(--color-ink) 22%,transparent);opacity:0}
.core{position:absolute;left:6px;top:6px;width:6px;height:6px;border-radius:50%;background:var(--color-white);opacity:.92}
.pa{animation-name:pa}.pb{animation-name:pb}.pc{animation-name:pc}.pd{animation-name:pd}

.tk{animation-name:tk;opacity:0}
.tkb{animation-name:tkb}.tkc{animation-name:tkc}.tkd{animation-name:tkd}.tke{animation-name:tke}
.fill{transform-origin:left center;transform:scaleX(0);animation-timing-function:linear}
.fb{animation-name:fb}.fc{animation-name:fc}

.lane{position:absolute;left:142px;width:718px;height:1px;background:linear-gradient(90deg,var(--color-lane) 6px,transparent 6px) 0 0/14px 1px repeat-x;animation:flow calc(1.4s*var(--k,1)) linear infinite;animation-play-state:paused}
.scan{position:absolute;left:0;top:0;width:100%;height:110px;background:linear-gradient(180deg,transparent,color-mix(in srgb,var(--color-white) 16%,transparent),transparent);animation:scan calc(3.6s*var(--k,1)) linear infinite;animation-play-state:paused}
.live{animation:live calc(2s*var(--k,1)) ease-in-out infinite;animation-play-state:paused}

#flow.is-playing .t,
#flow.is-playing .lg,
#flow.is-playing .lane,
#flow.is-playing .scan,
#flow.is-playing .live{animation-play-state:running}

.lg{display:flex;align-items:center;gap:10px;height:25px;font:400 12px/1 var(--font-mono);white-space:nowrap;opacity:0;animation-duration:calc(18s*var(--k,1));animation-iteration-count:1;animation-fill-mode:both;animation-timing-function:ease-out;animation-play-state:paused}
.lg i{display:block;width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
.lg span{color:var(--color-ink-2)}
.l1{animation-name:lg1}.l2{animation-name:lg2}.l3{animation-name:lg3}.l4{animation-name:lg4}.l5{animation-name:lg5}.l6{animation-name:lg6}.l7{animation-name:lg7}.l8{animation-name:lg8}.l9{animation-name:lg9}.l10{animation-name:lg10}.l11{animation-name:lg11}.l12{animation-name:lg12}.l13{animation-name:lg13}.l14{animation-name:lg14}.l15{animation-name:lg15}.l16{animation-name:lg16}.l17{animation-name:lg17}.l18{animation-name:lg18}

@keyframes flow{to{background-position:14px 0}}
@keyframes scan{from{transform:translateY(-110px)}to{transform:translateY(560px)}}
@keyframes live{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes win{0%,1%{opacity:0;transform:translateY(6px) scale(.96)}2.5%,14%{opacity:1;transform:none}16.5%,100%{opacity:0;transform:translateY(-4px)}}
@keyframes ring{0%{opacity:0;transform:scale(.4)}.4%{opacity:.9;transform:scale(.4)}5%{opacity:0;transform:scale(2.6)}100%{opacity:0;transform:scale(2.6)}}

@keyframes pa{
0%{opacity:0;color:var(--color-ink-2);transform:translateX(0) scale(.4)}
3%{opacity:1;color:var(--color-ink-2);transform:translateX(0) scale(1)}
