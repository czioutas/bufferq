<script>
  const flow = document.getElementById("flow");
  if (flow) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            flow.classList.add("is-playing");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(flow);
  }
</script>
