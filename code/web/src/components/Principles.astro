---
const cards = [
  {
    tag: "Latency",
    stat: "<10 ms",
    title: "Under 10 ms per evaluation.",
    body: "bufferq runs as a sidecar, in front of every call. A gate that's slower than the request it's guarding defeats the point of a sidecar — every rate-limit and classification check is held to that target.",
  },
  {
    tag: "HATEOAS",
    stat: "links",
    title: "Every response says what's next.",
    body: "A Granted response carries a complete link. A Queued response carries a poll link. A caller doesn't need to know the API ahead of time — it follows what the response gives it, not a hardcoded route.",
  },
  {
    tag: "Payments",
    stat: "402",
    title: "402-native, not bolted on.",
    body: "BillWalled is wired to a real HTTP 402 in the controller — the status code fires the moment the service can produce it. No capacity rule or payment processor decides that yet.",
  },
];
---

<div class="border-b border-rule">
  <div class="section py-24" style="max-width: 1120px;">
    <h2
      class="font-bold tracking-tight text-ink"
      style="font-size: clamp(32px, 4.4vw, 46px); line-height: 1.08; letter-spacing: -0.04em;"
    >
      Three things that matter
    </h2>

    <div class="mt-11 flex flex-wrap gap-5">
      {
        cards.map((c) => (
          <div class="min-w-0 flex-[1_1_320px] rounded-[6px] border border-rule bg-paper-2 p-8">
            <div class="eyebrow" style="letter-spacing: 0.08em;">{c.tag}</div>
            <div class="mono mt-7 text-5xl font-medium tracking-tight">{c.stat}</div>
            <h3 class="mt-7 text-xl font-semibold leading-snug tracking-tight text-ink">{c.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{c.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>
