#!/usr/bin/env bash
# Enforces the commit message convention GitVersion.yml relies on for
# version bumping (major/minor/patch/no-bump "type:" tags).
set -euo pipefail

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Merge commits and fixup/squash commits aren't hand-written, skip them.
if echo "$commit_msg" | grep -qE '^(Merge |fixup!|squash!)'; then
  exit 0
fi

pattern='^type:[[:space:]]?(breaking|major|feature|minor|fix|patch|none|skip|web|fix-ecosystem|feature-ecosystem|breaking-ecosystem|patch-ecosystem)'
subject=$(echo "$commit_msg" | head -n1)

if ! echo "$subject" | grep -Eq "$pattern"; then
  echo "error: commit message must start with a GitVersion type tag (see GitVersion.yml), e.g.:" >&2
  echo "         type: fix: short description      - patch bump" >&2
  echo "         type: feature: short description  - minor bump" >&2
  echo "         type: breaking: short description - major bump" >&2
  echo "         type: skip: short description     - no version bump" >&2
  echo "" >&2
  echo "your message:" >&2
  echo "$commit_msg" | sed 's/^/  /' >&2
  exit 1
fi
